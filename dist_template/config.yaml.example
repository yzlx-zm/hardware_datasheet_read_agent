# 2. 文档处理配置
document:
  input_dir: "input_docs"
  input_file: ""
  output_base_name: ""
  output_formats:
    - "markdown"
    - "word"
    - "excel"
    - "csv"

# 3. 归档配置
archive:
  use_timestamp_folder: true
  archive_root_dir: "output_archive"

# 4. 日志配置
logging:
  level: "INFO"
  log_dir: "agent_logs"

# 5. 审核配置
review:
  enabled: true
  strict_mode: false
  max_retries: 2
  checks:
    structure: true
    table_format: true
    data_consistency: true
