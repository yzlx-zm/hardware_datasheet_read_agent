# ================= 硬件文档 Agent 配置文件模板 =================
# 复制此文件，重命名为 config.yaml，然后填入你的真实配置

# 1. AI 模型配置（选择一个配置，删除其他的）
# ========== 示例1：OpenAI 官方配置 ==========
llm:
  api_key: "sk-xxx"
  model_name: "gpt-4o-mini"
  base_url: "https://api.openai.com/v1"
  temperature: 0.05

# ========== 示例2：阿里云通义千问配置 ==========
# llm:
#   api_key: "sk-xxx"
#   model_name: "qwen-max-latest"
#   base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
#   temperature: 0.05

# ========== 示例3：百度文心一言配置 ==========
# llm:
#   api_key: "sk-xxx"
#   model_name: "ernie-4.0-turbo-128k"
#   base_url: "https://qianfan.baidubce.com/v2"
#   temperature: 0.05

# ========== 示例4：DeepSeek 配置 ==========
# llm:
#   api_key: "sk-xxx"
#   model_name: "deepseek-chat"
#   base_url: "https://api.deepseek.com/v1"
#   temperature: 0.05

# 2. 文档处理配置
document:
  # 文档存放根目录
  input_dir: "input_docs"
  # 默认要处理的文档文件名（支持相对input_dir的路径/绝对路径）
  input_file: "test.pdf"
  # 生成的归档文档主文件名 (不含后缀)
  # ✅ 留空则自动根据输入文件名生成，格式：[输入文件名主体]_通信协议归档
  # ✅ 手动填写则固定使用该名称，优先级最高
  output_base_name: ""
  # 输出格式列表：可多选 ["markdown", "word", "excel", "csv"]
  output_formats:
    - "markdown"
    - "word"
    - "excel"
    - "csv"

# 3. 归档配置
archive:
  # 是否按时间戳创建子文件夹
  use_timestamp_folder: true
  # 归档文件根目录
  archive_root_dir: "output_archive"

# 4. 日志配置
logging:
  # 日志级别: DEBUG, INFO, WARNING, ERROR
  level: "INFO"
  # 日志文件保存目录
  log_dir: "agent_logs"

# 5. 审核配置（新增）
review:
  # 是否启用深度审核
  enabled: true
  # 严格模式：审核不通过则终止（false则仅警告继续输出）
  strict_mode: false
  # 最大重试次数（审核不通过时）
  max_retries: 2
  # 各检查项开关
  checks:
    # 结构完整性检查（9章节是否完整）
    structure: true
    # 表格格式检查（Markdown表格语法）
    table_format: true
    # 数据一致性检查（关键数据与原文比对）
    data_consistency: true
